[Unit]
Description=DayTrade Strategy Lab (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/daytrade-lab
ExecStart=/home/ubuntu/.local/bin/uv run --frozen --no-dev uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
